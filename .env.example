LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
PORT=3000
NODE_ENV=production
BASE_URL=https://your-domain.ngrok-free.app

# Kafka — required, proxy publishes all events here
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=line-webhook-events
KAFKA_CLIENT_ID=line-webhook-proxy

# NOTE: DOWNSTREAM_URL / SERVICE_A_DOWNSTREAM_URL / SERVICE_B_DOWNSTREAM_URL
# are no longer used by the proxy. Each consumer service manages its own target URL.
